{
  "name": "pico",
  "version": "0.2.2",
  "description": "A small, durable, local-first agent runtime",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "npm run plugins:build && tsx watch src/server.ts",
    "dev:executor": "tsx watch src/executor/agent.ts",
    "start": "node dist/server/server.js",
    "start:executor": "node dist/executor-agent.mjs",
    "deploy": "node scripts/deploy-production.mjs",
    "deploy:plan": "node scripts/deploy-production.mjs --plan",
    "build": "npm run plugins:build && npm run typecheck && npm run build:server && npm run build:executor && npm run build:webui",
    "plugins:build": "node scripts/build-plugins.mjs",
    "plugins:build:chatgpt": "node scripts/build-plugins.mjs chatgpt",
    "build:plugins:runtime": "node scripts/build-plugins.mjs runtime",
    "build:plugins:ui": "node scripts/build-plugins.mjs ui",
    "build:webui": "vite build",
    "build:server": "node scripts/clean-server-build.mjs && tsc --project tsconfig.build.json",
    "build:executor": "esbuild src/executor/agent.ts --bundle --platform=node --format=esm --target=node22 --external:node:* --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=dist/executor-agent.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'test/**/*.ts' 'plugins/**/*.{ts,tsx,mjs,md,html}' '!plugins/**/runtime.mjs' README.md package.json package-lock.json tsconfig*.json vite.config.ts eslint.config.js",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'test/**/*.ts' 'plugins/**/*.{ts,tsx,mjs,md,html}' '!plugins/**/runtime.mjs' README.md package.json package-lock.json tsconfig*.json vite.config.ts eslint.config.js",
    "test": "npm run plugins:build && vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
