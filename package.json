{
  "name": "pico",
  "version": "0.1.0",
  "description": "A small, durable, local-first agent runtime",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:executor": "tsx watch src/executor/agent.ts",
    "start": "node dist/server/server.js",
    "start:executor": "node dist/server/executor/agent.js",
    "build": "tsc --noEmit && tsc --project tsconfig.build.json && vite build",
    "plugins:build:chatgpt": "esbuild src/plugins/chatgpt-plan.ts --bundle --platform=node --format=esm --target=node20 --external:node:* --minify --outfile=plugins/pico.chatgpt-plan/runtime.mjs && vite build --config plugins/pico.chatgpt-plan/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'test/**/*.ts' 'plugins/**/*.{ts,tsx,mjs,md,html}' README.md package.json package-lock.json tsconfig*.json vite.config.ts eslint.config.js",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'test/**/*.ts' 'plugins/**/*.{ts,tsx,mjs,md,html}' README.md package.json package-lock.json tsconfig*.json vite.config.ts eslint.config.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
